# ==============================================================================
# TARK Studio — Production Environment Configuration Template
# For Oracle Cloud Always Free VM (Ubuntu ARM64 Ampere A1)
# ==============================================================================

# Application Configuration
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
UVICORN_WORKERS=2

# PostgreSQL & pgvector Database Credentials
POSTGRES_USER=tark_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=tark_studio
POSTGRES_PORT=5432

# External AI Provider API Keys
# Obtain a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=

# Embedding Provider Configuration
# For independent cloud production (Render, etc.), use Cloudflare Workers AI with BGE-Base-EN-v1.5 (768d)
# Model: @cf/baai/bge-base-en-v1.5
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Domain & SSL (Free DuckDNS + Caddy Automatic TLS)
# Point your DuckDNS domain to your Oracle VM Public IP
DOMAIN=your-subdomain.duckdns.org
ACME_EMAIL=your-email@example.com

# Frontend Origin for CORS (e.g. your Cloudflare Pages deployment URL)
# Multiple origins can be comma-separated: https://tark-studio.pages.dev,https://custom-domain.com
CORS_ORIGINS=https://tark-studio.pages.dev

# Reranker & Memory Configuration
RERANKER_TYPE=onnx
RERANKER_TOP_K=5
RERANKER_CANDIDATE_K=20
MEMORY_TOKEN_BUDGET=2048
MEMORY_SUMMARY_THRESHOLD_TOKENS=1024
