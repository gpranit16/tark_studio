# ==============================================================================
# TARK Studio — Environment Configuration Example
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL + pgvector Database Configuration
# In Docker Compose, the container uses these values.
# If running PostgreSQL locally or in Docker on another port, adjust POSTGRES_PORT.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tark_studio
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# SQLAlchemy Async Connection URL
# Override this if using an external database or connection pooler.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/tark_studio

# LLM Providers
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=

# Reranker Configuration (baseline, onnx)
RERANKER_TYPE=onnx
RERANKER_TOP_K=5
RERANKER_CANDIDATE_K=20
